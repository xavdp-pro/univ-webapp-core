# Copy to .env inside /apps/<name>/app/ (next to package.json). Never commit .env.
# The app name itself comes from package.json "name"; APP_NAME only overrides it.
# APP_NAME=

# ---- Processes ---------------------------------------------------------------
NODE_ENV=production
# API bind address. Keep 127.0.0.1: only the local proxy may call the API.
HOST=127.0.0.1
PORT=7700
# Vite dev server port (development only). The public proxy targets it in dev.
VITE_PORT=7701
# Hosts Vite accepts when served through a public proxy (comma separated).
# VITE_ALLOWED_HOSTS=app.example.com
# Public host for HMR websocket when Vite sits behind a TLS proxy.
# VITE_HMR_HOST=app.example.com
# VITE_HMR_CLIENT_PORT=443
# Number of proxies in front of the API (express "trust proxy"), so rate limits see client IPs.
TRUST_PROXY=1

# ---- Production build served by the API --------------------------------------
# true: the API serves dist/ (run `npm run build` first) and the vite process is not needed.
SERVE_DIST=false

# ---- Public URL used inside magic-link e-mails --------------------------------
PUBLIC_URL=http://127.0.0.1:7701

# ---- Sessions ----------------------------------------------------------------
# Required in production (>= 16 chars); the API refuses to start otherwise.
JWT_SECRET=
# COOKIE_NAME=<app>_session
SESSION_DAYS=30

# ---- Database (MariaDB) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Default to the app name for user and database.
# DB_USER=
# DB_NAME=
# Either the password itself, or a file holding it (host convention: /apps/<name>/etc/mysql/localhost/passwd).
DB_PASSWORD=
# DB_PASSWORD_FILE=/apps/<name>/etc/mysql/localhost/passwd
DB_POOL_SIZE=10

# ---- Allowed users (bootstrap of auth_users at API boot) ----------------------
# email|Display Name|role, comma separated. Each address missing from auth_users is
# inserted; an address already there (active or removed) is left untouched: the
# Users page (/admin/users) owns it from then on. Put the first admin here.
AUTH_USERS=someone@example.com|Someone|admin

# ---- Magic links -------------------------------------------------------------
MAGIC_LINK_TTL_MINUTES=15
MAGIC_MAX_PER_EMAIL=5
MAGIC_MAX_PER_IP=10
MAGIC_RATE_WINDOW_MINUTES=15
# Front route that consumes the link (token travels in the URL fragment).
LOGIN_PATH=/login

# ---- Mail (Mailjet) ----------------------------------------------------------
# Required in production. Absent outside production: links are printed on the API console.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=

# ---- Generic rate limits -----------------------------------------------------
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15MIN=30

# ---- Realtime (Socket.IO) ----------------------------------------------------
REALTIME_ENABLED=false
