{
  "name": "univ-webapp-core",
  "version": "0.1.0",
  "description": "Shared web-app mold for Shaper apps: Express 5 API + Vite/React front, magic-link auth, MariaDB, PM2.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "node --watch server/index.js",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/migrations/run.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.38.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "mysql2": "^3.22.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.8",
    "vitest": "~4.0.18"
  }
}
